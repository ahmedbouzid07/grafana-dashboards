{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
    { "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["logging"], "targetBlank": false, "title": "Logging Dashboards", "type": "dashboards" }
    ],
    "panels": [
    {
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
        "id": 1,
        "options": {
        "content": "# Logs Explorer\n\nBrowse logs from all sources. Filter by **Cluster**, **Namespace/Instance**, **Pod**, **Container**. Use **Search** for pattern matching.",
        "mode": "markdown"
        },
        "transparent": true,
        "type": "text"
    },
    {
        "gridPos": { "h": 3, "w": 6, "x": 0, "y": 2 },
        "id": 2,
        "title": "Log Lines",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]},
            "unit": "short"
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 6, "x": 6, "y": 2 },
        "id": 3,
        "title": "Errors",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"(?i)error\" !~ \"(?i)(no error|error=nil|errors=0)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 6, "x": 12, "y": 2 },
        "id": 4,
        "title": "Warnings",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 20 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"(?i)(warn|warning)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 6, "x": 18, "y": 2 },
        "id": 5,
        "title": "Rate (lines/sec)",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]},
            "unit": "short",
            "decimals": 1
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["mean"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(rate({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" [$__interval]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
        "id": 10,
        "title": "Log Volume",
        "type": "timeseries",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 1 }
        }
        },
        "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "sortBy": "Total", "sortDesc": true }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum by (cluster) (count_over_time({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" [$__interval]))",
        "legendFormat": "{{cluster}}",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 18, "w": 24, "x": 0, "y": 10 },
        "id": 20,
        "title": "Logs",
        "type": "logs",
        "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
        },
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "{cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\", container=~\"$container\"} |~ \"$search\" |~ \"$level\"",
        "refId": "A"
        }]
    }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "tags": ["logging"],
    "templating": {
    "list": [
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values(cluster)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Cluster",
        "multi": false,
        "name": "cluster",
        "options": [],
        "query": { "label": "cluster", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values({cluster=~\"$cluster\"}, namespace)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Namespace",
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": { "label": "namespace", "stream": "{cluster=~\"$cluster\"}", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values({cluster=~\"$cluster\", namespace=~\"$namespace\"}, pod)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Pod",
        "multi": false,
        "name": "pod",
        "options": [],
        "query": { "label": "pod", "stream": "{cluster=~\"$cluster\", namespace=~\"$namespace\"}", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values({cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\"}, container)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Container",
        "multi": false,
        "name": "container",
        "options": [],
        "query": { "label": "container", "stream": "{cluster=~\"$cluster\", namespace=~\"$namespace\", pod=~\"$pod\"}", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Search",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
        },
        {
        "current": { "selected": true, "text": "All", "value": "" },
        "hide": 0,
        "label": "Level",
        "multi": false,
        "name": "level",
        "options": [
            { "selected": true, "text": "All", "value": "" },
            { "selected": false, "text": "Error", "value": "(?i)error" },
            { "selected": false, "text": "Warning", "value": "(?i)(warn|warning)" },
            { "selected": false, "text": "Info", "value": "(?i)info" },
            { "selected": false, "text": "Debug", "value": "(?i)debug" }
        ],
        "query": "All : ,Error : (?i)error,Warning : (?i)(warn|warning),Info : (?i)info,Debug : (?i)debug",
        "type": "custom"
        }
    ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"] },
    "timezone": "",
    "title": "Logs Explorer",
    "uid": "logs-explorer",
    "version": 1
}