        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "{cluster=~\"$cluster\", instance=~\"$instance\", unit=~\"$unit\"} |~ \"$search\"",
        "refId": "A"
        }]
    }
