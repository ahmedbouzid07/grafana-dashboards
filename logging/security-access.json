{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
    { "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["logging"], "targetBlank": false, "title": "Logging Dashboards", "type": "dashboards" }
    ],
    "panels": [
    {
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
        "id": 1,
        "options": {
        "content": "# Security & Access Logs\n\nAuthentication events, SSH sessions, sudo commands, and HTTP access errors. Filter by **Cluster** and **Event Type**.",
        "mode": "markdown"
        },
        "transparent": true,
        "type": "text"
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 0, "y": 2 },
        "id": 2,
        "title": "Auth Failures",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"(?i)(authentication failed|login failed|invalid password|access denied)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 4, "y": 2 },
        "id": 3,
        "title": "SSH Failed",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 3 },
            { "color": "red", "value": 10 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sshd.*Failed\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 8, "y": 2 },
        "id": 4,
        "title": "SSH Accepted",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sshd.*Accepted\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 12, "y": 2 },
        "id": 5,
        "title": "Sudo Commands",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sudo.*COMMAND\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 16, "y": 2 },
        "id": 6,
        "title": "HTTP 401/403",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"\\\" (401|403) \" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 3, "w": 4, "x": 20, "y": 2 },
        "id": 7,
        "title": "Critical/Fatal",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"(?i)(critical|fatal|panic|emergency)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
        "id": 10,
        "title": "Security Events Timeline",
        "type": "timeseries",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 30, "lineWidth": 2 }
        },
        "overrides": [
            { "matcher": { "id": "byName", "options": "Auth Failed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" }}]},
            { "matcher": { "id": "byName", "options": "SSH Accepted" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" }}]},
            { "matcher": { "id": "byName", "options": "Sudo" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" }}]}
        ]
        },
        "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right" }},
        "targets": [
        {
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"(?i)(authentication failed|login failed|sshd.*Failed)\" [$__interval]))",
            "legendFormat": "Auth Failed",
            "refId": "A"
        },
        {
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sshd.*Accepted\" [$__interval]))",
            "legendFormat": "SSH Accepted",
            "refId": "B"
        },
        {
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sudo.*COMMAND\" [$__interval]))",
            "legendFormat": "Sudo",
            "refId": "C"
        }
        ]
    },
    {
        "gridPos": { "h": 15, "w": 24, "x": 0, "y": 10 },
        "id": 20,
        "title": "Security Logs",
        "type": "logs",
        "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
        },
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "{cluster=~\"$cluster\"} |~ \"$event_filter\" |~ \"$search\"",
        "refId": "A"
        }]
    }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "tags": ["logging", "security"],
    "templating": {
    "list": [
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values(cluster)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "options": [],
        "query": { "label": "cluster", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": true, "text": "All Security", "value": "(?i)(auth|login|sshd|sudo|permission|denied|forbidden|401|403|failed|credential)" },
        "hide": 0,
        "label": "Event Type",
        "multi": false,
        "name": "event_filter",
        "options": [
            { "selected": true, "text": "All Security", "value": "(?i)(auth|login|sshd|sudo|permission|denied|forbidden|401|403|failed|credential)" },
            { "selected": false, "text": "SSH Only", "value": "sshd" },
            { "selected": false, "text": "Sudo Only", "value": "sudo" },
            { "selected": false, "text": "Auth Failures", "value": "(?i)(authentication failed|login failed|access denied|invalid password)" },
            { "selected": false, "text": "HTTP 401/403", "value": "\\\" (401|403) " }
        ],
        "query": "All Security : (?i)(auth|login|sshd|sudo|permission|denied|forbidden|401|403|failed|credential),SSH Only : sshd,Sudo Only : sudo,Auth Failures : (?i)(authentication failed|login failed|access denied|invalid password),HTTP 401/403 : \\\" (401|403) ",
        "type": "custom"
        },
        {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Search",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
        }
    ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"] },
