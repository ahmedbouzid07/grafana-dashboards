{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
    { "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["logging"], "targetBlank": false, "title": "Logging Dashboards", "type": "dashboards" }
    ],
    "panels": [
    {
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
        "id": 1,
        "options": {
        "content": "# User & Admin Activities\n\nTrack authentication, access, and administrative actions. Select **Cluster** and **Application** (namespace) to view specific service logs.",
        "mode": "markdown"
        },
        "transparent": true,
        "type": "text"
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 2 },
        "id": 2,
        "title": "Auth Failures",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(?i)(authentication failed|login failed|invalid password|access denied|permission denied|unauthorized)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 2 },
        "id": 3,
        "title": "Successful Logins",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(?i)(login success|authenticated|session started|Accepted|logged in)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 2 },
        "id": 4,
        "title": "SSH Sessions",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sshd.*(Accepted|session opened)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 2 },
        "id": 5,
        "title": "Sudo Commands",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"sudo.*COMMAND\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 2 },
        "id": 6,
        "title": "HTTP 401/403",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 50 }
            ]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(401|403|Unauthorized|Forbidden)\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 2 },
        "id": 7,
        "title": "Total Events",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
        "id": 10,
        "title": "Authentication Events Timeline",
        "type": "timeseries",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 30, "lineWidth": 2 }
        },
        "overrides": [
            { "matcher": { "id": "byName", "options": "Failed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" }}]},
            { "matcher": { "id": "byName", "options": "Success" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" }}]}
        ]
        },
        "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right" }},
        "targets": [
        {
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(?i)(authentication failed|login failed|access denied|unauthorized)\" [$__interval]))",
            "legendFormat": "Failed",
            "refId": "A"
        },
        {
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "sum(count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(?i)(login success|authenticated|Accepted|logged in)\" [$__interval]))",
            "legendFormat": "Success",
            "refId": "B"
        }
        ]
    },
    {
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
        "id": 11,
        "title": "Activity by Application",
        "type": "timeseries",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 60, "stacking": { "mode": "normal" } }
        }
        },
        "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "sortBy": "Total", "sortDesc": true }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum by (namespace) (count_over_time({cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"(?i)(auth|login|session|user|access)\" [$__interval]))",
        "legendFormat": "{{namespace}}",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 15, "w": 24, "x": 0, "y": 12 },
        "id": 20,
        "title": "Application Logs",
        "type": "logs",
        "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
        },
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "{cluster=~\"$cluster\", namespace=~\"$app\"} |~ \"$search\"",
        "refId": "A"
        }]
    },
    {
        "collapsed": true,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
        "id": 100,
        "title": "Bare-metal Admin Access (SSH/Sudo)",
        "type": "row",
        "panels": [
        {
            "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
            "id": 30,
            "title": "SSH & Sudo Logs",
            "type": "logs",
            "options": {
            "showTime": true,
            "showLabels": true,
            "wrapLogMessage": true,
            "enableLogDetails": true,
            "sortOrder": "Descending"
            },
            "targets": [{
            "datasource": { "type": "loki", "uid": "loki-main" },
            "expr": "{cluster=~\"$cluster\"} |~ \"(sshd|sudo)\" |~ \"$search\"",
            "refId": "A"
            }]
        }
        ]
    }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "tags": ["logging", "security", "admin", "authentication"],
    "templating": {
    "list": [
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values(cluster)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "options": [],
        "query": { "label": "cluster", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values({cluster=~\"$cluster\"}, namespace)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Application",
        "multi": true,
        "name": "app",
        "options": [],
        "query": { "label": "namespace", "stream": "{cluster=~\"$cluster\"}", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Search",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
        }
    ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"] },
