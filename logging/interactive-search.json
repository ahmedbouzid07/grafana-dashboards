{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [
    { "asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["logging"], "targetBlank": false, "title": "Logging Dashboards", "type": "dashboards" }
    ],
    "panels": [
    {
        "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
        "id": 1,
        "options": {
        "content": "# Interactive Log Search\n\nSearch across all log sources. Enter a **Search Pattern** (regex supported) and filter by **Cluster** and **Log Level**.",
        "mode": "markdown"
        },
        "transparent": true,
        "type": "text"
    },
    {
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 2 },
        "id": 2,
        "title": "Matching Lines",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }]},
            "unit": "short"
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(count_over_time({cluster=~\"$cluster\"} |~ \"$search\" |~ \"$level\" [$__range]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 2 },
        "id": 3,
        "title": "Match Rate (lines/sec)",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }]},
            "unit": "short"
        }
        },
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["mean"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum(rate({cluster=~\"$cluster\"} |~ \"$search\" |~ \"$level\" [$__interval]))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 2 },
        "id": 4,
        "title": "Clusters with Matches",
        "type": "stat",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }]}
        }
        },
        "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "count(sum by (cluster) (count_over_time({cluster=~\"$cluster\"} |~ \"$search\" |~ \"$level\" [$__range])))",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
        "id": 10,
        "title": "Matches Over Time",
        "type": "timeseries",
        "fieldConfig": {
        "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 60, "stacking": { "mode": "normal" } }
        }
        },
        "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "sortBy": "Total", "sortDesc": true }},
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "sum by (cluster) (count_over_time({cluster=~\"$cluster\"} |~ \"$search\" |~ \"$level\" [$__interval]))",
        "legendFormat": "{{cluster}}",
        "refId": "A"
        }]
    },
    {
        "gridPos": { "h": 18, "w": 24, "x": 0, "y": 12 },
        "id": 20,
        "title": "Search Results",
        "type": "logs",
        "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
        },
        "targets": [{
        "datasource": { "type": "loki", "uid": "loki-main" },
        "expr": "{cluster=~\"$cluster\"} |~ \"$search\" |~ \"$level\"",
        "refId": "A"
        }]
    }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "tags": ["logging", "search", "interactive"],
    "templating": {
    "list": [
        {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki-main" },
        "definition": "label_values(cluster)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "options": [],
        "query": { "label": "cluster", "type": 1 },
        "refresh": 2,
        "type": "query"
        },
        {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Search Pattern",
        "name": "search",
        "options": [],
        "query": "",
        "type": "textbox"
        },
        {
        "current": { "selected": true, "text": "All", "value": "" },
        "hide": 0,
        "label": "Log Level",
        "multi": false,
        "name": "level",
        "options": [
            { "selected": true, "text": "All", "value": "" },
            { "selected": false, "text": "Error", "value": "(?i)error" },
            { "selected": false, "text": "Warning", "value": "(?i)(warn|warning)" },
            { "selected": false, "text": "Info", "value": "(?i)info" },
            { "selected": false, "text": "Debug", "value": "(?i)debug" }
        ],
        "query": "All : ,Error : (?i)error,Warning : (?i)(warn|warning),Info : (?i)info,Debug : (?i)debug",
        "type": "custom"
        }
    ]
    },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"] },
    "timezone": "",
    "title": "Interactive Log Search",
    "uid": "log-search",
    "version": 1
}
